# ==============================================================================
# AI TREND CONTENT AUTOMATION AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development
APP_URL=http://localhost:3000

# Database Connection (PostgreSQL or local SQLite for zero-config dev)
# For Supabase / PostgreSQL: postgresql://postgres:password@localhost:5432/autonomus_posts?schema=public
DATABASE_URL=file:./dev.db

# Queue (Redis URL for BullMQ; leave empty to run in zero-dependency in-memory queue mode)
# REDIS_URL=redis://localhost:6379

# AI Provider (mock | openai | anthropic | gemini | openrouter)
LLM_PROVIDER=mock
# LLM_API_KEY=sk-your-llm-api-key
# LLM_MODEL=gpt-4o

# Web Search Provider (mock | serper | tavily | duckduckgo)
WEB_SEARCH_PROVIDER=mock
# WEB_SEARCH_API_KEY=your-search-api-key

# LinkedIn Developer API Integration
# Create an app at https://www.linkedin.com/developers/
# Required Products: "Share on LinkedIn", "Sign In with LinkedIn using OpenID Connect"
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# X (Twitter) Developer API Integration
# Create a project at https://developer.x.com/
# Required Scopes: tweet.read, tweet.write, users.read, offline.access
# X_CLIENT_ID=your-x-client-id
# X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# Security & Secret Encryption
# Generate 64-char hex key: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=development-session-secret-at-least-32-chars-long!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Automation & Safety Thresholds
PUBLISHING_MODE=APPROVAL_REQUIRED
MIN_TREND_SCORE=70
MIN_QUALITY_SCORE=85
MAX_POSTS_PER_DAY=2
